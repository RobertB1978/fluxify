# AI Fairytale Audio Generator - Stage 1 Configuration
# Copy this file to .env and adjust paths for your system

# Database
DATABASE_URL=sqlite:///../../data/db.sqlite3

# Piper TTS Configuration  
PIPER_BINARY=../../bin/piper.exe
PIPER_MODEL_PATH=../../models/pl_PL-medium.onnx
PIPER_MODEL_CONFIG=../../models/pl_PL-medium.onnx.json

# Audio Export
EXPORT_BITRATE=192k

# Logging
LOG_DIR=../../logs

# Server
HOST=127.0.0.1
PORT=8000
