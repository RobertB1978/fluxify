# FastAPI application settings
APP_NAME=AI Fairytale Audio Generator
ENVIRONMENT=development
LOG_LEVEL=INFO
LOG_DIRECTORY=/logs
LOG_RETENTION_DAYS=7

# Database configuration
DATABASE_URL=sqlite:///../../data/db.sqlite3

# Rate limiting
RATE_LIMIT_REQUESTS=120
RATE_LIMIT_WINDOW_SECONDS=60

# Data directories
DATA_DIRECTORY=../../data
ASSETS_SUBDIR=assets
EXPORTS_SUBDIR=exports

# Piper TTS configuration
PIPER_BINARY=/opt/piper/piper
PIPER_MODEL_PATH=/opt/piper/models/pl_PL-voice.onnx
PIPER_MODEL_CHECKSUM=SHA256_OF_ONNX
PIPER_CONFIG_PATH=/opt/piper/models/pl_PL-voice.onnx.json
PIPER_CONFIG_CHECKSUM=SHA256_OF_JSON
PIPER_MAX_RETRIES=3
PIPER_RETRY_BACKOFF_SECONDS=1.5
PIPER_ENABLE_FALLBACK=false

# CORS
ALLOWED_ORIGINS=
CORS_ALLOW_METHODS=*
CORS_ALLOW_HEADERS=*
CORS_ALLOW_CREDENTIALS=true
